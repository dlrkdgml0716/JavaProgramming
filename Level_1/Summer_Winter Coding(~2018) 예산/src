import java.util.*;
class Solution {
    public int solution(int[] d, int budget) {
        int answer = 0;
        int total = budget;
        Arrays.sort(d);
        for(int i = 0; i < d.length; i++){
            if(total - d[i] >= 0){
                total -= d[i];
                answer++;
            }
        }
        return answer;
    }
}